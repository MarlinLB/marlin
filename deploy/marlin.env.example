# Per-host values read by marlind.service and marlin.service. Copy to
# /etc/marlin/marlin.env. See docs/DEPLOYMENT.md §1.2.

IFACE=
MARLIN_PIN_DIR=/sys/fs/bpf/marlin

# Only needed if marlin.bpf.o is not installed at the default
# /usr/lib/marlin/marlin.bpf.o -- e.g. pointing at a build tree directly.
#MARLIN_OBJ=/usr/lib/marlin/marlin.bpf.o
