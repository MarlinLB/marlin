[Unit]
Description=Marlin control plane
Requires=marlind.service
After=marlind.service

[Service]
Type=exec
EnvironmentFile=/etc/marlin/marlin.env
ExecStart=/usr/lib/marlin/Marlin.Api
Restart=on-failure
RestartSec=5s
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service bpf
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
