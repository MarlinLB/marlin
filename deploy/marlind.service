[Unit]
Description=Marlin XDP datapath
Wants=network-pre.target
After=network-pre.target
Before=marlin.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=/etc/marlin/marlin.env
ExecStart=/usr/lib/marlin/marlind attach
Restart=on-failure
RestartSec=1s
OOMScoreAdjust=-500
MemoryAccounting=yes
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service bpf
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
