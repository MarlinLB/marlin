# Marlin — EOL normalisation only. Formatting is owned elsewhere:
# data-plane/.clang-format (C), control-plane/.editorconfig (C#).
# See docs/REPO-STRUCTURE.md §5, row "/.gitattributes".
#
# Everything here is forced to LF. Git ops happen from WSL2 (autocrlf=false);
# Rider on Windows only edits/builds, it does not commit. Forcing LF avoids a
# second, conflicting EOL policy on the Windows side.

* text=auto eol=lf

# Datapath C — clang-format assumes LF; a CRLF file changes every line's
# byte length under -target bpf tooling that counts columns.
*.c text eol=lf
*.h text eol=lf

# data-plane/scripts/*.sh are dev-rig helpers with a shebang line; a CRLF
# shebang fails to exec. deploy/*.service and *.env.example aren't executed
# directly but ship beside loader/main.c's compiled binary (itself covered
# by the *.c rule above, for a different reason) and keep the same policy.
*.sh text eol=lf
*.service text eol=lf
*.env.example text eol=lf

# Control plane — .NET tooling and dotnet format accept LF; keep one policy
# rather than forcing CRLF sln/csproj against everything else.
*.cs text eol=lf
*.sln text eol=lf
*.csproj text eol=lf
*.props text eol=lf

# Docs and config
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Never rewritten
*.png binary
*.o binary
*.bpf.o binary
