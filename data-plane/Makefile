# Marlin data-plane build

SRC_DIR   := src
INC_DIR   := include
BUILD_DIR := build
TEST_DIR  := tests

# --- Overridable tools --------------------------------------------------------
# CI pins versions here; check-toolchain's own tests inject stubs through
# these same variables (see data-plane/mk/toolchain.mk).
CLANG        ?= clang
BPFTOOL      ?= bpftool
READELF      ?=
CLANG_FORMAT ?= clang-format
CLANG_TIDY   ?= clang-tidy

# The unit tests are host code, not BPF: HOST_CC defaults separately from
# CLANG above so a cross-compiling CI job can still run tests natively.
# -fno-sanitize=alignment: parser.c overlays wire structs directly onto a
# byte buffer at arbitrary offsets (e.g. an iphdr at the 14-byte Ethernet
# offset), which is unaligned by construction -- the same pattern the kernel
# itself uses for packet parsing, and x86 tolerates it in hardware. UBSan's
# alignment check flags every such access as UB; ASan and the rest of UBSan
# stay on.
HOST_CC       ?= $(CLANG)
TEST_SANITIZE ?= -fsanitize=address,undefined -fno-sanitize=alignment
TEST_CFLAGS   ?= -std=gnu11 -g -O1 -Wall -Wextra -Werror -fno-omit-frame-pointer

include mk/toolchain.mk

.DEFAULT_GOAL := all

MULTIARCH_TRIPLET := $(shell dpkg-architecture -qDEB_HOST_MULTIARCH 2>/dev/null \
	|| gcc -print-multiarch 2>/dev/null \
	|| echo "$$(uname -m)-linux-gnu")

INCLUDES := -I$(INC_DIR)
ifneq ($(MULTIARCH_TRIPLET),)
MULTIARCH_INC := /usr/include/$(MULTIARCH_TRIPLET)
ifneq ($(wildcard $(MULTIARCH_INC)),)
INCLUDES += -I$(MULTIARCH_INC)
else
$(warning data-plane/Makefile: no directory at $(MULTIARCH_INC) -- pass MULTIARCH_TRIPLET=<dir under /usr/include> explicitly if <asm/types.h> fails to resolve)
endif
endif

SRCS := $(wildcard $(SRC_DIR)/*.c)
OBJS := $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SRCS))

# Recursive: include/marlin/ already nests (abi/types.h), and docs/REPO-STRUCTURE.md
# Sec2's target tree nests it further (abi/, plus limits.h, enums.h) as more lands.
HDRS := $(shell find $(INC_DIR) -name '*.h')

# docs/design/03-translation-units.md "Linking": each .c compiles separately;
# bpftool gen object links the objects, BTF included, into one marlin.bpf.o.
MARLIN_OBJ := $(BUILD_DIR)/marlin.bpf.o

# docs/REPO-STRUCTURE.md Sec6 lists compile_commands.json as a build-flow output,
# and Sec5 says clang-tidy is inert without one ("every file fails to parse
# instead of reporting findings"). Generated by concatenating each translation
# unit's `-MJ` fragment -- Sec5's first of the two mechanisms it names, the
# other being `bear --` -- into one JSON array; the compile rule below emits
# the fragment alongside its .o. The trailing comma clang -MJ leaves on every
# fragment is the documented join point: stripped only from the last line of
# the concatenated stream, once, so the result is a valid array.
CC_JSON := $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o.json,$(SRCS))
COMPILE_COMMANDS := $(BUILD_DIR)/compile_commands.json

# Native unit tests over parser.c (docs/design/24-testing.md). Deliberately
# not part of $(SRCS): that wildcard is compiled -target bpf and linked into
# marlin.bpf.o, and these are host binaries that #include the source
# directly to reach its static helpers.
TEST_SRCS := $(wildcard $(TEST_DIR)/*.c)
TEST_HDRS := $(wildcard $(TEST_DIR)/*.h)
TEST_BIN  := $(BUILD_DIR)/tests/marlin_tests

.PHONY: all
all: $(MARLIN_OBJ)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(BUILD_DIR)
	@echo "compile $(notdir $<)"
	@$(CLANG) -target bpf -mcpu=v3 -g -O2 $(INCLUDES) -MJ $(BUILD_DIR)/$*.o.json -c -o $@ $<

$(MARLIN_OBJ): $(OBJS)
	@echo "link $(notdir $@)"
	@$(BPFTOOL) gen object $@ $(OBJS)

$(COMPILE_COMMANDS): $(OBJS)
	@echo "generate $(notdir $@)"
	@{ echo '['; cat $(CC_JSON) | sed '$$s/,$$//'; echo ']'; } > $@

# All test cases live in one translation unit (it #includes src/parser.c, so
# a second one would duplicate marlin_parse); depending on every header
# under $(INC_DIR) is coarser than necessary but matches $(OBJS) above,
# which has no per-file header dependency tracking either (no -MMD there).
$(TEST_BIN): $(TEST_SRCS) $(TEST_HDRS) $(SRC_DIR)/parser.c $(HDRS)
	@mkdir -p $(dir $@)
	@echo "compile tests"
	@$(HOST_CC) $(TEST_CFLAGS) $(TEST_SANITIZE) $(INCLUDES) -MMD -MP -o $@ $(TEST_SRCS)

.PHONY: tests
tests: $(TEST_BIN)
	@$(TEST_BIN)

-include $(TEST_BIN).d

.PHONY: ci
ci:
	$(MAKE) check-toolchain
	$(MAKE) all
	$(MAKE) tests

# check-toolchain is invoked as a recursive $(MAKE), not listed as a
# prerequisite -- mk/toolchain.mk's MARLIN_CHECK_STRICT reads MAKECMDGOALS of
# whichever make process is asked for check-toolchain, so only a literal,
# separate invocation makes Group B (clang-format/clang-tidy) fatal here. As
# an ordinary prerequisite it would only warn, the same as a build's does.
# Same reasoning as `ci` above; the side effect is that a missing/too-old
# clang or bpftool also fails `format`/`tidy`, since check-toolchain is one
# target covering both groups (mk/toolchain.mk's comment on why it isn't two).

.PHONY: format
format:
	$(MAKE) check-toolchain
	@$(CLANG_FORMAT) -i --style=file:$(MARLIN_REPO_ROOT)/.clang-format $(SRCS) $(HDRS)

.PHONY: tidy
tidy:
	@$(MAKE) $(COMPILE_COMMANDS)
	@$(CLANG_TIDY) --config-file=$(MARLIN_REPO_ROOT)/.clang-tidy -p $(BUILD_DIR) $(SRCS)

.PHONY: clean
clean:
	rm -rf $(BUILD_DIR)
