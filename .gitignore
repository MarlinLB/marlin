# Marlin — ignore rules. Layout per docs/REPO-STRUCTURE.md §2.
#
# Three build trees: data-plane/ (clang -target bpf for marlin.bpf.o, host
# clang for marlind/), control-plane/ (dotnet), tests/. The folder is opened
# in both VS Code and Rider, so both IDEs' local state is covered here.

# ---------------------------------------------------------------------------
# Datapath — clang/bpftool output (docs/REPO-STRUCTURE.md §6)
# ---------------------------------------------------------------------------

# Per-unit objects and the bpftool gen object link result. docs/design/
# 03-translation-units.md compiles each .c separately, so both live in-tree
# unless the Makefile redirects them.
*.o
*.bpf.o

# clang intermediates: -emit-llvm, -S, dependency files.
*.ll
*.bc
*.s
*.d

# compile_commands.json is generated by data-plane/Makefile (clang -MJ
# fragments or bear --) and is required for clang-tidy to resolve -target bpf
# (docs/REPO-STRUCTURE.md §5). Generated, not authored — never committed.
compile_commands.json
*.o.json
.cache/

# ---------------------------------------------------------------------------
# Control plane — .NET
# ---------------------------------------------------------------------------

[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/

# Per-user project state and MSBuild noise.
*.user
*.suo
*.userosscache
*.sln.docstates
*.binlog
msbuild.log
msbuild.err
msbuild.wrn

# Packages. Central package management (Directory.Packages.props) means
# nothing under packages/ is authored.
packages/
*.nupkg
*.snupkg
.nuget/
project.lock.json
project.assets.json

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

[Tt]est[Rr]esults/
*.trx
*.coverage
*.coverxml
coverage*.json
coverage*.xml
*.received.*

# tests/integration/ builds netns/veth topologies; captures are throwaway.
*.pcap
*.pcapng

# data-plane/tests' native test binary and marlind/main.c's compiled binary
# both carry no suffix, so the *.o/*.bpf.o globs above miss them; ignore the
# whole build tree rather than name each one alone.
data-plane/build/

# ---------------------------------------------------------------------------
# Packaging — nfpm output (packaging/mkdeb.sh)
# ---------------------------------------------------------------------------

/build/

# ---------------------------------------------------------------------------
# VS Code — share the workspace config, ignore local state
# ---------------------------------------------------------------------------

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
.vscode/*.log
*.code-workspace

# ---------------------------------------------------------------------------
# Rider / JetBrains — share the solution-level layer, ignore per-user
# ---------------------------------------------------------------------------

.idea/
.idea.*/
*.iml
*.sln.iml

# *.sln.DotSettings is team-shared; only the .user sidecar is local.
*.DotSettings.user
_ReSharper*/
*.[Rr]e[Ss]harper
*.dotCover
*.dotMemoryUnit

# Also drops in when a Visual Studio install touches the solution.
.vs/

# ---------------------------------------------------------------------------
# Local deployment state
# ---------------------------------------------------------------------------

# deploy/marlin.env.example and deploy/marlin.conf.example are committed
# (docs/REPO-STRUCTURE.md §2); a filled-in file names a real interface and
# pin path on one host, and for marlin.conf also every VIP's hash_key and
# table_seed (docs/design/31-file-configuration.md §10). Neither glob matches
# the .example suffix, so no negation is needed.
deploy/*.env
deploy/*.conf

# ---------------------------------------------------------------------------
# Editor and OS junk
# ---------------------------------------------------------------------------

*~
*.swp
*.swo
*.orig
*.rej
.DS_Store
Thumbs.db
